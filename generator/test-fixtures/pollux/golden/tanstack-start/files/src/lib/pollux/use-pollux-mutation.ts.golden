// SPEC-008 — mutation bridge for the shared UI contract on TanStack Start.
//
// The shared EntityForm/DeleteConfirm components expect an injected
// `onSubmit`/`onConfirm` that resolves `null` on success or the safe
// ApiErrorShape envelope on failure. TanStack Start has no route actions:
// mutations call the shared entity client directly (browser -> same-origin
// proxy) and pages revalidate with `router.invalidate()`. This hook wraps a
// mutation thunk with busy state and normalizes thrown errors into the safe
// envelope. The caller owns the idempotency key: one key per logical
// submission, reused across retries.
import { useCallback, useState } from 'react';

import type { ApiErrorShape, ApiResult } from './runtime/api-types';
import { errorMessages } from './runtime/errors-pt';

export function usePolluxMutation() {
  const [busy, setBusy] = useState(false);

  const mutate = useCallback(
    async <T>(
      fn: () => Promise<ApiResult<T>>
    ): Promise<ApiErrorShape | null> => {
      setBusy(true);
      try {
        const result = await fn();
        return result.ok ? null : result.error;
      } catch {
        return {
          code: 'INTERNAL',
          message: errorMessages.INTERNAL,
          requestId: '',
          retryable: false,
        };
      } finally {
        setBusy(false);
      }
    },
    []
  );

  return { mutate, busy };
}
