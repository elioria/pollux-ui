# Pollux standalone workspace — server-only environment (SPEC-003 subset).
# These variables are read via process.env inside server modules only and
# must NEVER be exposed with a VITE_ prefix: the upstream URL and credential
# may not reach client output. Provide them through the shell environment
# (e.g. `POLLUX_API_URL=... pnpm start`) or a dotenv wrapper of your choice —
# react-router-serve does not auto-load .env files.

# Upstream base URL of the generated Pollux REST service (server-only).
POLLUX_API_URL=http://localhost:8091

# Bounded server-side timeout for proxied upstream requests, in milliseconds.
# Default when unset: 10000 (10 s). Accepted range: 1..120000.
POLLUX_API_TIMEOUT_MS=10000

# DEV-ONLY fallback credential forwarded by the same-origin proxy as
# `Authorization: Bearer <POLLUX_DEV_BEARER>`, used ONLY when the request
# carries no BFF access cookie (see the auth section below). Never use a
# production credential here.
POLLUX_DEV_BEARER=token-admin

# --- BFF authentication (SPEC-003 "Authentication topology") ---------------
# All five variables below are required to enable the cookie/PKCE login flow
# (/api/pollux/auth/*). When ANY is missing the auth endpoints answer 503 and
# the workspace stays in the DEV-ONLY POLLUX_DEV_BEARER mode above.

# Server-only URL of the TypeScript authorization host (Better Auth app that
# exposes GET /api/pollux/authorize, POST /api/pollux/token|revoke).
POLLUX_AUTH_URL=http://localhost:3000

# BFF client credentials registered in the authorization host's
# POLLUX_AUTH_CLIENTS (exact callback URL:
# ${POLLUX_PUBLIC_ORIGIN}/api/pollux/auth/callback). Secret is server-only —
# never commit a real value.
POLLUX_AUTH_CLIENT_ID=
POLLUX_AUTH_CLIENT_SECRET=

# Server-only secret for sealing the login state cookie (AES-GCM via HKDF)
# and the CSRF HMAC. Generate with: openssl rand -base64 32
POLLUX_SESSION_SECRET=

# Canonical public origin of THIS workspace; also the Origin required on
# mutations. Cookies are Secure when it is https.
POLLUX_PUBLIC_ORIGIN=http://localhost:3000
