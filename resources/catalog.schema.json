{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "$id": "https://pollux.local/schemas/catalog.schema.json",
  "title": "PolluxResourceCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "sourceRevision",
    "resources",
    "catalogDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "catalogDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "sourcePaths",
        "packagePath",
        "sha256",
        "sourceRevision",
        "ownership",
        "mutationPolicy",
        "generatorSurfaces",
        "frameworkTargets",
        "supportStatus",
        "dependencies",
        "entrypoints",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(templates|layout|design|generator|reference|fixture)\\.[a-z0-9.-]+$"
        },
        "kind": {
          "enum": [
            "template-tree",
            "layout-shell",
            "design-system",
            "generator-entrypoint",
            "reference",
            "fixture"
          ]
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "packagePath": {
          "type": ["string", "null"],
          "pattern": "^\\./resources/[A-Za-z0-9._/-]+$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ownership": {
          "enum": ["canonical-source", "generated-snapshot", "invoke-only"]
        },
        "mutationPolicy": {
          "enum": ["read-only", "copy", "render", "invoke"]
        },
        "generatorSurfaces": {
          "type": "array",
          "items": {
            "enum": [
              "manager",
              "generated",
              "generated-server",
              "go-backend",
              "standalone"
            ]
          }
        },
        "frameworkTargets": {
          "type": "array",
          "items": {
            "enum": [
              "start-ui-vite",
              "nextjs",
              "react-router",
              "astro",
              "tanstack-start"
            ]
          }
        },
        "supportStatus": {
          "enum": ["supported", "experimental", "reference-only"]
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "entrypoints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verification": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileEntry" }
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "path", "sha256", "bytes"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer" }
      }
    }
  }
}
