// fakeAuth lets contract tests run without a live Better Auth server. The
// database is nil on purpose: every request below must be rejected before
// any repository code runs, proving authorization and validation precede
// database access.
type fakeAuth struct {
	sessionErr error
	permErr    error
}

func (f *fakeAuth) Session(context.Context, string) (*auth.Session, error) {
	if f.sessionErr != nil {
		return nil, f.sessionErr
	}
	return &auth.Session{UserID: "user-1"}, nil
}

func (f *fakeAuth) RequirePermission(context.Context, string, string, string) error {
	return f.permErr
}

func (f *fakeAuth) Capabilities(context.Context, string, string) auth.Capabilities {
	return auth.Capabilities{CanRead: true}
}

// The bearer (v2) methods reuse the same failure knobs.
func (f *fakeAuth) SessionBearer(context.Context, string) (*auth.Session, error) {
	if f.sessionErr != nil {
		return nil, f.sessionErr
	}
	return &auth.Session{UserID: "user-1"}, nil
}

func (f *fakeAuth) RequirePermissionBearer(context.Context, string, string, string) error {
	return f.permErr
}

func newTestRouter(client auth.Client) *gin.Engine {
	gin.SetMode(gin.TestMode)
	engine := gin.New()
	engine.Use(middleware.RequestIDMiddleware())
	RegisterRoutes(engine.Group("/api/generated"), nil, client, nil)
	return engine
}

