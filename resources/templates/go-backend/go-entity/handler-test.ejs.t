func TestEveryOperationRejectsAnonymous(t *testing.T) {
	router := newTestRouter(&fakeAuth{sessionErr: httperr.New(httperr.Unauthenticated)})
	for _, op := range operations {
		status, body := perform(t, router, op.method, op.path, op.body)
		if status != http.StatusUnauthorized || body.OK || body.Error == nil || body.Error.Code != "UNAUTHENTICATED" {
			t.Fatalf("%s %s: expected 401 UNAUTHENTICATED, got %d %+v", op.method, op.path, status, body)
		}
		if body.Error.RequestID == "" {
			t.Fatalf("%s %s: missing requestId", op.method, op.path)
		}
	}
}

func TestEveryOperationRejectsForbidden(t *testing.T) {
	router := newTestRouter(&fakeAuth{permErr: httperr.New(httperr.Forbidden)})
	for _, op := range operations {
		status, body := perform(t, router, op.method, op.path, op.body)
		if status != http.StatusForbidden || body.OK || body.Error == nil || body.Error.Code != "FORBIDDEN" {
			t.Fatalf("%s %s: expected 403 FORBIDDEN, got %d %+v", op.method, op.path, status, body)
		}
	}
}

func TestCapabilitiesRequiresOnlyAuthentication(t *testing.T) {
	router := newTestRouter(&fakeAuth{})
	status, body := perform(t, router, http.MethodGet, "/api/generated/v1/<%= h.changeCase.camel(name) %>/capabilities", "")
	if status != http.StatusOK || !body.OK {
		t.Fatalf("capabilities: expected 200 ok, got %d %+v", status, body)
	}

	anonymous := newTestRouter(&fakeAuth{sessionErr: httperr.New(httperr.Unauthenticated)})
	status, body = perform(t, anonymous, http.MethodGet, "/api/generated/v1/<%= h.changeCase.camel(name) %>/capabilities", "")
	if status != http.StatusUnauthorized || body.OK {
		t.Fatalf("capabilities anonymous: expected 401, got %d %+v", status, body)
	}
}

// Validation failures below must return 400 before the nil database is ever
// touched; a panic here means validation ran after data access.
func TestValidationPrecedesDatabase(t *testing.T) {
	router := newTestRouter(&fakeAuth{})
	base := "/api/generated/v1/<%= h.changeCase.camel(name) %>"
	cases := []struct {
		label  string
		method string
		path   string
		body   string
	}{
		{"page unknown JSON field", http.MethodPost, base + "/page", `{"page":1,"perPage":10,"bogus":1}`},
		{"page invalid sort field", http.MethodPost, base + "/page", `{"page":1,"perPage":10,"sort":[{"id":"not_a_column","desc":true}]}`},
		{"page perPage above bound", http.MethodPost, base + "/page", `{"page":1,"perPage":101}`},
		{"create unknown field", http.MethodPost, base, `{"definitelyNotAField":1}`},
		{"update unknown patch key", http.MethodPatch, base + "/some-id", `{"data":{"definitelyNotAField":1}}`},
		{"update oversized id", http.MethodPatch, base + "/" + strings.Repeat("x", 200), `{"data":{}}`},
		{"bulk delete empty", http.MethodPost, base + "/bulk-delete", `{"ids":[]}`},
		{"bulk delete duplicate ids", http.MethodPost, base + "/bulk-delete", `{"ids":["a","a"]}`},
		{"malformed json", http.MethodPost, base + "/page", `{not json`},
	}
	for _, tc := range cases {
		status, body := perform(t, router, tc.method, tc.path, tc.body)
		if status != http.StatusBadRequest || body.OK || body.Error == nil || body.Error.Code != "VALIDATION_FAILED" {
			t.Fatalf("%s: expected 400 VALIDATION_FAILED, got %d %+v", tc.label, status, body)
		}
	}
}
