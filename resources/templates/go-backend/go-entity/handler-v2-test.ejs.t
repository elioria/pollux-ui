func TestV2RequestIDEchoedInEnvelope(t *testing.T) {
	router := newTestRouter(&fakeAuth{})
	supplied := "suite-req-id-123"
	status, body, headers := performV2(t, router, http.MethodGet, v2Base, "",
		map[string]string{"X-Request-Id": supplied})
	expectV2Error(t, "request id echo", status, body, http.StatusUnauthorized, "UNAUTHENTICATED")
	if body.RequestID != supplied {
		t.Fatalf("error envelope must echo the request id: %+v", body)
	}
	if headers.Get("X-Request-Id") != supplied {
		t.Fatalf("response header must echo the request id: %q", headers.Get("X-Request-Id"))
	}
}

func TestV2UnknownEntityIsNotFound(t *testing.T) {
	// NoRoute-level behavior is wired in app.NewEngine; at the entity level
	// an unknown sub-path under this entity must also be NOT_FOUND-safe.
	router := newTestRouter(&fakeAuth{})
	req := httptest.NewRequest(http.MethodGet, "/api/generated/v2/naoExisteEntidade", nil)
	req.Header.Set("Authorization", "Bearer token")
	recorder := httptest.NewRecorder()
	router.ServeHTTP(recorder, req)
	if recorder.Code != http.StatusNotFound {
		t.Fatalf("unknown entity must be 404, got %d", recorder.Code)
	}
}
