func TestV2ServerManagedFieldsNotWritable(t *testing.T) {
	router := newTestRouter(&fakeAuth{})
	headers := map[string]string{"Authorization": "Bearer token", "Idempotency-Key": "key-3"}
	status, body, _ := performV2(t, router, http.MethodPost, v2Base,
		`{"createdAt":"2020-01-01T00:00:00.000Z"}`, headers)
	expectV2Error(t, "server-managed field", status, body, http.StatusBadRequest, "VALIDATION_FAILED")
	if len(body.FieldErrors["createdAt"]) == 0 || body.FieldErrors["createdAt"][0] != "not_writable" {
		t.Fatalf("known non-writable field must map to not_writable: %+v", body.FieldErrors)
