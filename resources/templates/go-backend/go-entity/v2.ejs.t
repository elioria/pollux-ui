		case "varchar", "text":
			if filter.Op == "contains" {
				query = query.Where("? ILIKE ?", bun.Ident(column), "%"+escapeLike(filter.Value)+"%")
			} else {
				query = query.Where("? = ?", bun.Ident(column), filter.Value)
			}
		case "uuid":
			query = query.Where("?::text = ?", bun.Ident(column), filter.Value)
		case "boolean":
			if filter.Value != "true" && filter.Value != "false" {
				return nil, v2FilterError(filter.Field, "Valor booleano inválido")
			}
			query = query.Where("? = ?", bun.Ident(column), filter.Value == "true")
<% if (needStrconv) { -%>
		case "integer":
