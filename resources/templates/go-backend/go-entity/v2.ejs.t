		httperr.WithFieldErrors(map[string][]string{"f_" + field: {message}}))
}

// v2ApplyQuery applies q search and declared typed filters. Columns and
// operators come exclusively from generated allowlists.
func v2ApplyQuery(query *bun.SelectQuery, list *v2.ListQuery) (*bun.SelectQuery, error) {
