// V2Page runs the validated v2 list query; the count reuses the identical
// where clause (accurate totalRows even past the last page).
func (Repository) V2Page(ctx context.Context, db bun.IDB, list *v2.ListQuery) ([]Model, int, error) {
	rows := []Model{}
	query := db.NewSelect().Model(&rows)

	query, err := v2ApplyQuery(query, list)
	if err != nil {
		return nil, 0, err
	}

	for _, item := range list.Sort {
		column := v2SortColumns[item.ID]
		if item.Desc {
			query = query.OrderExpr("? DESC", bun.Ident(column))
		} else {
			query = query.OrderExpr("? ASC", bun.Ident(column))
		}
	}
	query = query.OrderExpr("? ASC", bun.Ident(pkColumn))

	total, err := query.
		Limit(list.PageSize).
		Offset((list.Page - 1) * list.PageSize).
		ScanAndCount(ctx)
	if err != nil {
		return nil, 0, err
	}
	return rows, total, nil
}
