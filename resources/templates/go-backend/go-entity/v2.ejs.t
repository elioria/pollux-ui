			if err != nil {
				return nil, v2FilterError(filter.Field, "Número inteiro inválido")
			}
			query = query.Where("? "+sqlOp+" ?", bun.Ident(column), parsed)
		case "float", "numeric":
			parsed, err := strconv.ParseFloat(filter.Value, 64)
			if err != nil {
				return nil, v2FilterError(filter.Field, "Número inválido")
			}
			query = query.Where("? "+sqlOp+" ?", bun.Ident(column), parsed)
<% } -%>
<% if (filterNeedsTime) { -%>
		case "date":
			parsed, err := time.Parse(v2DateFormat, filter.Value)
			if err != nil {
				return nil, v2FilterError(filter.Field, "Data inválida (use YYYY-MM-DD)")
			}
			query = query.Where("? "+sqlOp+" ?", bun.Ident(column), parsed)
		case "timestamp":
			parsed, err := time.Parse(time.RFC3339, filter.Value)
			if err != nil {
				return nil, v2FilterError(filter.Field, "Data/hora inválida (use ISO-8601)")
			}
			query = query.Where("? "+sqlOp+" ?", bun.Ident(column), parsed)
