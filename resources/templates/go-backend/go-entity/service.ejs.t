func staleWrite(current *Model, expected ExpectedUpdatedAt) bool {
	if !expected.Present {
		return false
	}
	currentValue := current.UpdatedAt
	if currentValue == nil && expected.Value == nil {
		return false
	}
	if currentValue == nil || expected.Value == nil {
		return true
	}
	return currentValue.Truncate(time.Millisecond).UnixMilli() != expected.Value.Truncate(time.Millisecond).UnixMilli()
}

