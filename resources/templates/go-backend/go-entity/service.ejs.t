}

// PageResult mirrors the TypeScript page contract.
type PageResult struct {
	Rows      []Model `json:"rows"`
	Total     int     `json:"total"`
	Page      int     `json:"page"`
	PerPage   int     `json:"perPage"`
	PageCount int     `json:"pageCount"`
}

// DeleteResult mirrors the TypeScript deletion contract.
type DeleteResult struct {
	DeletedCount int64 `json:"deletedCount"`
}

func (s *Service) List(ctx context.Context) ([]Model, error) {
	return s.repo.List(ctx, s.db)
}

func (s *Service) Page(ctx context.Context, input *PageInput) (*PageResult, error) {
	rows, total, err := s.repo.Page(ctx, s.db, input)
	if err != nil {
		return nil, err
	}
	pageCount := 0
	if total > 0 {
		pageCount = (total + input.PerPage - 1) / input.PerPage
	}
	return &PageResult{
		Rows:      rows,
		Total:     total,
		Page:      input.Page,
		PerPage:   input.PerPage,
		PageCount: pageCount,
	}, nil
}

func (s *Service) Get(ctx context.Context, id string) (*Model, error) {
	return s.repo.Get(ctx, s.db, id)
}

