func (s *Service) Delete(ctx context.Context, actor, requestID, id string) (*DeleteResult, error) {
	var result *DeleteResult
	err := s.db.RunInTx(ctx, &sql.TxOptions{}, func(ctx context.Context, tx bun.Tx) error {
		affected, err := s.repo.Delete(ctx, tx, id)
		if err != nil {
			return err
		}
		if affected == 0 {
			return httperr.New(httperr.NotFound)
		}
		recordID := id
		if err := audit.Insert(ctx, tx, audit.Event{
			RequestID:   requestID,
			ActorUserID: actor,
			Entity:      Entity,
			Operation:   "delete",
			RecordID:    &recordID,
		}); err != nil {
