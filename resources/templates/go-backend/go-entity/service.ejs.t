		return nil, err
	}
	return result, nil
}

// BulkDelete is atomic: when any requested row is missing, the whole
// transaction rolls back and nothing is deleted.
func (s *Service) BulkDelete(ctx context.Context, actor, requestID string, ids []string) (*DeleteResult, error) {
	var result *DeleteResult
	err := s.db.RunInTx(ctx, &sql.TxOptions{}, func(ctx context.Context, tx bun.Tx) error {
		affected, err := s.repo.BulkDelete(ctx, tx, ids)
		if err != nil {
			return err
		}
		if affected != int64(len(ids)) {
			return httperr.New(httperr.NotFound,
				httperr.WithMessage("Alguns registros não foram encontrados - Nenhuma exclusão foi realizada"))
		}
		if err := audit.Insert(ctx, tx, audit.Event{
			RequestID:   requestID,
			ActorUserID: actor,
			Entity:      Entity,
			Operation:   "bulk_delete",
			RecordCount: int(affected),
		}); err != nil {
			return err
		}
		result = &DeleteResult{DeletedCount: affected}
		return nil
	})
	if err != nil {
		return nil, err
	}
	return result, nil
}
