func TestExecuteConcurrentDuplicatesRunOnce(t *testing.T) {
	db := testDB(t)
	store := NewStore(db)
	scope := testScope()
	hash, _ := BodyHash([]byte(`{"titulo":"concorrente"}`))

	var mu sync.Mutex
	executions := 0
	slow := func(ctx context.Context, tx bun.Tx) (int, []byte, error) {
		mu.Lock()
		executions++
		mu.Unlock()
		time.Sleep(300 * time.Millisecond) // hold the transaction open
		return http.StatusCreated, []byte(`{"ok":true,"data":{"id":"one"}}`), nil
	}

	const workers = 4
	var wg sync.WaitGroup
	outcomes := make([]*Outcome, workers)
	errs := make([]error, workers)
	for i := 0; i < workers; i++ {
		wg.Add(1)
		go func(i int) {
			defer wg.Done()
			outcomes[i], errs[i] = store.Execute(context.Background(), scope, hash, slow)
		}(i)
	}
	wg.Wait()

	completed := 0
	for i := 0; i < workers; i++ {
		if errs[i] != nil {
			var typed *httperr.E
			if !errors.As(errs[i], &typed) || typed.Code != httperr.ServiceUnavailable {
				t.Fatalf("worker %d: unexpected error %v", i, errs[i])
			}
			continue
		}
		completed++
		if outcomes[i].Status != http.StatusCreated {
			t.Fatalf("worker %d: unexpected status %d", i, outcomes[i].Status)
		}
	}
	if completed == 0 {
		t.Fatal("at least one duplicate must observe the completed mutation")
	}
	if executions != 1 {
		t.Fatalf("mutation ran %d times under concurrency, want exactly 1", executions)
	}
}

