// countingMutation counts real executions; the body it returns embeds the
// execution ordinal so replays are provably the stored bytes.
func countingMutation(counter *int, mu *sync.Mutex) Mutation {
	return func(ctx context.Context, tx bun.Tx) (int, []byte, error) {
		mu.Lock()
		*counter++
		n := *counter
		mu.Unlock()
		return http.StatusCreated, []byte(fmt.Sprintf(`{"ok":true,"data":{"execution":%d}}`, n)), nil
	}
}

